# Template of every configuration value. Copy it to .env and fill LLM_API_KEY:
#   cp .env.example .env
# The application reads only .env (git-ignored, never commit it); app/core/config/settings.py
# has no defaults, so a variable missing from .env stops the boot with its name. Environment
# variables override .env. Empty value = not set.

APP_NAME=plpgsql-modernizer
LOG_LEVEL=INFO

# PostgreSQL (async driver). Docker Compose overrides the host to `postgres`.
DATABASE_URL=postgresql+asyncpg://modernizer:modernizer@localhost:5432/modernizer
DATABASE_ECHO=false

# LLM, single provider (used when LLM_CONFIG_FILE is empty): openrouter | openai
#   openrouter -> official OpenRouter SDK; LLM_MODEL is any slug from https://openrouter.ai/models
#   openai     -> api.openai.com (or any OpenAI-compatible endpoint via LLM_BASE_URL)
# The results in examples/results/ were produced with this model and reasoning effort.
LLM_PROVIDER=openrouter
LLM_MODEL=z-ai/glm-5.3-flash
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TIMEOUT_SECONDS=120
# Reasoning models (e.g. glm, o-series): cap the thinking budget, or it can eat all output
# tokens. Empty = not sent (provider default).
LLM_REASONING_EFFORT=low
# Additional attempts for transient failures.
LLM_MAX_RETRIES=2
# Circuit breaker: after N consecutive failures (retries already spent), fail fast for R s.
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
LLM_CIRCUIT_BREAKER_RESET_SECONDS=60

# LLM gateway with several providers/models and failover: copy config/llm.example.yml to
# config/llm.yml and point to it. Then the LLM_PROVIDER..LLM_CIRCUIT_BREAKER_* variables above
# are ignored and each provider reads its key from the variable named by its api_key_env.
LLM_CONFIG_FILE=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Repair loop (validation -> code_generation with the issues as feedback). 1 disables it.
CODE_GENERATION_MAX_ATTEMPTS=2
# No retry starts once the run is older than this (the request is synchronous).
CODE_GENERATION_RETRY_BUDGET_SECONDS=90

# Ruff check of the generated code.
RUFF_TIMEOUT_SECONDS=20

# Langfuse (optional): both keys enable graph traces + LLM prompts, output and token usage.
# Self-hosted UI: docker compose -f docker-compose.langfuse.yml up -d
# Generate random values locally; never commit real keys/passwords.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
# Local Langfuse stack (docker-compose.langfuse.yml) only:
# LANGFUSE_LOCAL_PASSWORD=<random>
# LANGFUSE_LOCAL_SALT=<random>
# LANGFUSE_LOCAL_ENCRYPTION_KEY=<64 hex characters>
# LANGFUSE_LOCAL_AUTH_SECRET=<random>
# LANGFUSE_LOCAL_USER_EMAIL=reviewer@modernizer.local
# LANGFUSE_LOCAL_USER_PASSWORD=<random>

# Behavior check + evaluation metric (POST /modernizations/{id}/evaluation, GET /evaluations).
# It EXECUTES generated code: point it at a disposable database, never the app's
# (docker/postgres/init creates modernizer_eval). Empty = behavior check skipped, evaluation
# endpoints answer 500.
EVALUATION_DATABASE_URL=postgresql+asyncpg://modernizer:modernizer@127.0.0.1:5432/modernizer_eval
EVALUATION_DATASET_FILE=examples/evaluation/scenarios.yml
EVALUATION_CASE_TIMEOUT_SECONDS=10

# Integration tests only (database created by docker/postgres/init). Not read by the app.
TEST_DATABASE_URL=postgresql+asyncpg://modernizer:modernizer@localhost:5432/modernizer_test
