# Copy to .env and adjust. Never commit .env (it is git-ignored).

# PostgreSQL (async driver). Docker Compose overrides the host to `postgres`.
DATABASE_URL=postgresql+asyncpg://modernizer:modernizer@localhost:5432/modernizer

# LLM gateway with several providers/models and failover: copy config/llm.example.yml to
# config/llm.yml and point to it. Then the LLM_PROVIDER..LLM_CIRCUIT_BREAKER_* variables below
# are ignored and each provider reads its key from the variable named by its api_key_env.
# LLM_CONFIG_FILE=config/llm.yml
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Single LLM provider (used when LLM_CONFIG_FILE is unset): openrouter | openai
#   openrouter -> official OpenRouter SDK; LLM_MODEL is any slug from https://openrouter.ai/models
#   openai     -> api.openai.com (or any OpenAI-compatible endpoint via LLM_BASE_URL)
LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-sonnet-4.5
LLM_API_KEY=
# LLM_BASE_URL=
# LLM_TEMPERATURE=0.0
# LLM_MAX_OUTPUT_TOKENS=8192
# LLM_TIMEOUT_SECONDS=120
# Reasoning models (e.g. glm, o-series): cap the thinking budget, or it can eat all output tokens.
# LLM_REASONING_EFFORT=low
# LLM_MAX_RETRIES=2  # additional attempts; OpenRouter adapter preserves this count
# Circuit breaker: after N consecutive failures (retries already spent), fail fast for R s.
# LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# LLM_CIRCUIT_BREAKER_RESET_SECONDS=60

# Repair loop (validation -> generation with the issues as feedback). 1 disables it.
# GENERATION_MAX_ATTEMPTS=2
# GENERATION_RETRY_BUDGET_SECONDS=90

LOG_LEVEL=INFO

# Optional Langfuse: both keys enable graph traces + LLM prompts, output and token usage.
# Self-hosted UI: docker compose -f docker-compose.langfuse.yml up -d
# Generate random values locally; never commit real keys/passwords.
# LANGFUSE_PUBLIC_KEY=pk-lf-<random>
# LANGFUSE_SECRET_KEY=sk-lf-<random>
# LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_DOCKER_BASE_URL=http://host.docker.internal:3000
# LANGFUSE_LOCAL_PASSWORD=<random>
# LANGFUSE_LOCAL_SALT=<random>
# LANGFUSE_LOCAL_ENCRYPTION_KEY=<64 hex characters>
# LANGFUSE_LOCAL_AUTH_SECRET=<random>
# LANGFUSE_LOCAL_USER_EMAIL=reviewer@modernizer.local
# LANGFUSE_LOCAL_USER_PASSWORD=<random>

# Evaluation metric (POST /modernizations/{id}/evaluation, GET /evaluations, run_examples).
# It EXECUTES generated code: point it at a disposable database, never the app's
# (docker/postgres/init creates modernizer_eval). Unset = evaluation endpoints answer 500.
EVALUATION_DATABASE_URL=postgresql+asyncpg://modernizer:modernizer@127.0.0.1:5432/modernizer_eval
# EVALUATION_DATASET_FILE=examples/evaluation/scenarios.yml
# EVALUATION_CASE_TIMEOUT_SECONDS=10

# Integration tests only (database created by docker/postgres/init).
TEST_DATABASE_URL=postgresql+asyncpg://modernizer:modernizer@localhost:5432/modernizer_test
